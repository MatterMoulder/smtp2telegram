TG_BOT_TOKEN=123456:REPLACE_ME

# Optional: Set this to send all emails to a single Telegram chat (when Zitadel is disabled)
# If unset and Zitadel is disabled, the application will not start
# TG_CHAT_ID=123456789

SMTP_HOST=0.0.0.0
SMTP_PORT=2525

SMTP_USERNAME=telegram
SMTP_PASSWORD=change-this-password
SMTP_AUTH_REQUIRED=true
SMTP_TLS_ENABLED=true
SMTP_AUTH_REQUIRE_TLS=false
SMTP_REQUIRE_STARTTLS=false
SMTP_TLS_CERT_FILE=
SMTP_TLS_KEY_FILE=

ALLOWED_NETWORKS=127.0.0.0/8,192.168.1.0/24
MAX_MESSAGE_BYTES=10485760
MAX_BODY_CHARS=24000

ZITADEL_ENABLED=false
ZITADEL_BASE_URL=https://example.com
